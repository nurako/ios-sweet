<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.gltest</string>
	<!--
	    OPT-IN: a broken GPU client can panic the kernel, so this job must not
	    run on a normal boot.  It runs once only when the root carries the
	    sentinel /var/tmp/run-gl-test; the sentinel is removed first, so a
	    panic leaves the next boot safe.  To run it deliberately:
	        touch <mounted-root>/var/tmp/run-gl-test    (or on the phone)
	    then reboot.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>if [ -e /var/tmp/run-gl-test ]; then rm -f /var/tmp/run-gl-test; sleep 5; export DYLD_LIBRARY_PATH=/usr/local/lib; /usr/local/bin/gl_test &gt; /dev/hakios-usb 2&gt;&amp;1 || /usr/local/bin/gl_test &gt; /dev/console 2&gt;&amp;1; fi</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
