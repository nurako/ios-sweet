<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.gltest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>if [ -e /var/tmp/run-gl-test ]; then rm -f /var/tmp/run-gl-test; echo "GLTEST: start"; sleep 5; export DYLD_LIBRARY_PATH=/usr/local/lib; /usr/local/bin/gl_test 2&gt;&amp;1; rc=$?; echo "GLTEST: exit $rc"; exit $rc; fi</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
