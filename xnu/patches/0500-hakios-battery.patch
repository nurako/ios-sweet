+/*
+ * Alioth (Mi 11X / K40 / POCO F3, SM8250-AC): PM8150B on SPMI SID 2.
+ * fg-gen4 is split across fg-batt-soc@0x4000 (hardware monotonic SOC at
+ * +0x09, shadow +0x0A) and fg-batt-info@0x4100 (battery-missing +0x07,
+ * VBATT +0xA0/shadow +0xA6, IBATT +0xA2/shadow +0xA8). SMB5's charger
+ * state machine is at 0x1006 and USBIN_PLUGIN (bit 4) at 0x1310.
+ * Conversions are the vendor ones (fg-util.c):
+ *   uV = raw * 122070 / 1000, uA = sign16(raw) * 488281 / 1000,
+ * positive current = discharging (IOPMPowerSource wants charging > 0).
+ * The shadow copies certify a non-torn sample without writing HOLD.
+ */
+#define ALIOTH_BATT_SID          2u
+#define ALIOTH_BATT_SOC_BASE     0x4000u
+#define ALIOTH_BATT_INFO_BASE    0x4100u
+#define ALIOTH_TYPE              (ALIOTH_BATT_SOC_BASE + 0x04u)
+#define ALIOTH_MSOC              (ALIOTH_BATT_SOC_BASE + 0x09u)
+#define ALIOTH_MSOC_CP           (ALIOTH_BATT_SOC_BASE + 0x0Au)
+#define ALIOTH_SYS_BATT          (ALIOTH_BATT_INFO_BASE + 0x07u)
+#define ALIOTH_VBATT             (ALIOTH_BATT_INFO_BASE + 0xA0u)
+#define ALIOTH_VBATT_CP          (ALIOTH_BATT_INFO_BASE + 0xA6u)
+#define ALIOTH_IBATT             (ALIOTH_BATT_INFO_BASE + 0xA2u)
+#define ALIOTH_IBATT_CP          (ALIOTH_BATT_INFO_BASE + 0xA8u)
+#define ALIOTH_USBIN_RT_STS      0x1310u
+#define ALIOTH_CHGR_STATUS1      0x1006u
+#define ALIOTH_CHGR_STATUS2      0x1007u
+#define ALIOTH_USBIN_PLUGIN_BIT  0x10u
+#define ALIOTH_CAPACITY_MAH      4520u
+
+static bool
+aliothShadowByte(unsigned address, unsigned copyAddress, uint8_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t a, b;
+		if (sweet_spmi_read(ALIOTH_BATT_SID, address, &a) ||
+		    sweet_spmi_read(ALIOTH_BATT_SID, copyAddress, &b)) {
+			return false;
+		}
+		if (a == b) {
+			*value = a;
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+aliothShadowWord(unsigned address, unsigned copyAddress, uint16_t *value)
+{
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t a0, a1, b0, b1;
+		if (sweet_spmi_read(ALIOTH_BATT_SID, address, &a0) ||
+		    sweet_spmi_read(ALIOTH_BATT_SID, address + 1, &a1) ||
+		    sweet_spmi_read(ALIOTH_BATT_SID, copyAddress, &b0) ||
+		    sweet_spmi_read(ALIOTH_BATT_SID, copyAddress + 1, &b1)) {
+			return false;
+		}
+		if (a0 == b0 && a1 == b1) {
+			*value = (uint16_t)((unsigned)a0 | ((unsigned)a1 << 8));
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Vendor fg_get_msoc(): 255 -> 100, 0 -> 0, else round((raw-1)*98/253)+1. */
+static unsigned
+aliothMonotonicPercent(uint8_t raw)
+{
+	if (raw == 0xffu) {
+		return 100;
+	}
+	if (raw == 0u) {
+		return 0;
+	}
+	return (unsigned)((((unsigned)raw - 1u) * 98u + 126u) / 253u) + 1u;
+}
