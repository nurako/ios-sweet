+
+/*
+ * One-byte PMIC write. Deliberately narrow: only alioth's PM8150L flash
+ * module (SID 5, peripheral 0xd3), only through a channel whose owner is
+ * execution environment 0, and only one byte per transfer. The torch driver
+ * checks the register list; this function is the last gate before a PMIC
+ * register changes.
+ *
+ * The arbiter's write channels live at 0x0c600000 + 0x10000 * APID. The
+ * channel is mapped once and reused. A dropped transfer (the button driver
+ * sees those from time to time) is retried twice; any other error is fatal
+ * for this lane (poisoned, like a timed-out read).
+ */
+#define SP_CHNLS_PA 0x0c600000u
+#define SP_STATUS_DONE    0x1u
+#define SP_STATUS_FAILURE 0x2u
+#define SP_STATUS_DENIED  0x4u
+#define SP_STATUS_DROPPED 0x8u
+
+static vm_offset_t sp_wr;
+static uint16_t sp_wr_apid = SP_NO_APID;
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || sid != 5 || peripheral != 0xd3 || addr > 0xffffu) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	/* Find a channel for SID5/0xd3 that belongs to our execution env. */
+	uint16_t apid = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ((sid << 8) | peripheral)) {
+			continue;
+		}
+		if ((sp_rd(sp_cfg, 0x700u + 4u * i) & 7u) == 0u) {
+			apid = (uint16_t)i;
+			break;
+		}
+	}
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	if (sp_wr == 0 || sp_wr_apid != apid) {
+		/* One channel is enough: the flash module's. */
+		sp_wr = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+		sp_wr_apid = apid;
+	}
+	if (!sp_wr) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	uint32_t cmd = ((addr & 0xffu) << 4); /* write long, one byte */
+	int result = -1;
+	for (unsigned tries = 0; tries < 3; ++tries) {
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(sp_wr + 0x10) = value;
+		*(volatile uint32_t *)(sp_wr + 0x00) = cmd;
+		__asm__ volatile("dsb osh" ::: "memory");
+		uint32_t status = 0;
+		unsigned waited;
+		for (waited = 0; waited < 1000; ++waited) {
+			status = sp_rd(sp_wr, 0x08u);
+			if (status & SP_STATUS_DONE) {
+				break;
+			}
+			delay(1);
+		}
+		if (!(status & SP_STATUS_DONE)) {
+			sp_poisoned[apid] = true;
+			printf("SWEET SPMI: write timeout sid=%u addr=%#x APID=%u\n",
+			    sid, addr, apid);
+			break;
+		}
+		if (status & (SP_STATUS_FAILURE | SP_STATUS_DENIED)) {
+			printf("SWEET SPMI: write refused(%#x) sid=%u addr=%#x\n",
+			    status, sid, addr);
+			break;
+		}
+		if (status & SP_STATUS_DROPPED) {
+			continue; /* not made: ask again */
+		}
+		result = 0;
+		break;
+	}
+	IOLockUnlock(sp_lock);
+	return result;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
