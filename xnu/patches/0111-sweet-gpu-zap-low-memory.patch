  * qcom_mdt_pas_init): a 32-bit ELF, program headers from byte 52, 32 bytes
  * each, the hash segment's size the file size of program header 1.
  */
+/*
+ * Same metadata, but placed in the GPU's reserved PIL region (0x8681a000, below
+ * 4 GiB) instead of a kernel page. TrustZone refused the kernel page on alioth
+ * (-3145797) even after a cold power cycle; the PIL region is the memory the
+ * PAS protocol expects TrustZone to touch.
+ */
+static bool
+gpu_zap_header_low(const uint8_t *mdt, unsigned int size, uint64_t *phys)
+{
+	if (size > 0x2000u)     /* the whole pil_gpu_region on alioth */
+		return false;
+	vm_offset_t at = ml_io_map_wcomb(ZAP_MEMORY_PA, round_page(size));
+	if (!at)
+		return false;
+	for (unsigned int i = 0; i < size; ++i)
+		((volatile uint8_t *)at)[i] = mdt[i];
+	__asm__ volatile("dsb sy" ::: "memory");
+	*phys = ZAP_MEMORY_PA;
+	return true;
+}
