 /*
+ * Full response trace for a failed read: rx[0..3] carry status/hdr, the
+ * remaining bytes show what the IC actually shifted out (capped so one
+ * fbcon line stays readable).
+ */
+static void
+touch_trace(const char *why, uint16_t reg, const uint8_t *rx, unsigned n)
+{
+	printf("ALIOTH TOUCH: fts reg %#x %s frame:", reg, why);
+	for (unsigned i = 0; i < n && i < 24u; ++i) {
+		printf(" %02x", rx[i]);
+	}
+	printf("\n");
+}
