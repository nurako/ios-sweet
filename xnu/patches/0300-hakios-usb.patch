+/* usbreplay=1: the persistent console ring to the port when the computer opens it */
+#define REPLAY_CHUNK            2048
+#define REPLAY_SECS             30              /* give up if the computer does not read for this long */
+static int usbreplay;                           /* boot argument, default off */
