diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index f585be7..29b7512 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -701,13 +701,22 @@ static uint64_t _Atomic sweet_log_total;
 static int sweet_log_chan;
 static uint32_t sweet_log_secs = SWEET_LOG_SECS;
 
+/*
+ * Off until sweet_log_start() has found the partition and started the writer:
+ * boot text before then has nowhere to go, and the sweetlogdump of the
+ * previous session runs before this is set, so a dump cannot append itself.
+ */
+static bool sweet_log_ready;
+static bool sweet_log_paused;
+
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
 
 void
 sweet_log_append(const char *c, int size)
 {
-	if (size <= 0) {
+	if (size <= 0 || !__atomic_load_n(&sweet_log_ready, __ATOMIC_ACQUIRE) ||
+	    __atomic_load_n(&sweet_log_paused, __ATOMIC_ACQUIRE)) {
 		return;
 	}
 	uint64_t at = os_atomic_add_orig(&sweet_log_total, (uint64_t)size, relaxed);
@@ -818,6 +827,8 @@ sweet_log_start(void)
 	}
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
+		__atomic_store_n(&sweet_log_ready, true, __ATOMIC_RELEASE);
+		printf("SWEET LOG: now capturing all console output (kernel and userland tty)\n");
 	}
 }
 
@@ -861,11 +872,14 @@ sweet_log_dump(void)
 	if (want <= 0) {
 		return;
 	}
+	/* The dump prints through console_write(): do not append its own output. */
+	__atomic_store_n(&sweet_log_paused, true, __ATOMIC_RELEASE);
 	if ((uint32_t)want > SWEET_LOG_SIZE) {
 		want = SWEET_LOG_SIZE;
 	}
 	if (!su.nblocks || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
 		printf("SWEET LOGDUMP: partition too small for a saved log\n");
+		__atomic_store_n(&sweet_log_paused, false, __ATOMIC_RELEASE);
 		return;
 	}
 	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
@@ -879,6 +893,7 @@ sweet_log_dump(void)
 	if (ufs_read_blocks(base, 1) != 0) {
 		lck_mtx_unlock(&sweet_ufs_lock);
 		printf("SWEET LOGDUMP: header read failed\n");
+		__atomic_store_n(&sweet_log_paused, false, __ATOMIC_RELEASE);
 		return;
 	}
 	memcpy(&h, bounce, sizeof(h));
@@ -886,6 +901,7 @@ sweet_log_dump(void)
 	    h.size != SWEET_LOG_SIZE) {
 		lck_mtx_unlock(&sweet_ufs_lock);
 		printf("SWEET LOGDUMP: no saved log in the last blocks\n");
+		__atomic_store_n(&sweet_log_paused, false, __ATOMIC_RELEASE);
 		return;
 	}
 	uint64_t total = h.total;
@@ -929,6 +945,7 @@ sweet_log_dump(void)
 	}
 	lck_mtx_unlock(&sweet_ufs_lock);
 	printf("SWEET LOGDUMP: end\n");
+	__atomic_store_n(&sweet_log_paused, false, __ATOMIC_RELEASE);
 	/*
 	 * The dump is many lines and scrolls away in under a second. With
 	 * sweetlogdumpwait=N the boot thread holds here for N seconds so the
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index c86b9e7..93a926a 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -282,7 +282,13 @@ _cnputs(char *c, int size, bool poll)
 	extern int disableConsoleOutput;
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
-	sweet_log_append(c, size);
+	/*
+	 * The persistent log is fed once, at console_write() below, for every
+	 * writer including the tty/console device path from userland (kmoutput()
+	 * calls console_write(), not this function). Do not append here too:
+	 * console_ring_try_empty() calls _cnputs() again for bytes that were
+	 * already logged when they entered console_write().
+	 */
 	if (sweet_console_muted && !panic_active()) {
 		return;
 	}
@@ -531,6 +537,11 @@ console_write(char *str, int size)
 {
 	assert(str != NULL);
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* Every console writer, kernel printf and userland /dev/console alike. */
+	sweet_log_append(str, size);
+#endif
+
 	char *write_ptr = NULL;
 	int chunk_size = CPU_CONS_BUF_SIZE;
 	int i = 0;
@@ -607,6 +618,10 @@ console_write(char *str, int size)
 void
 console_write_unbuffered(char c)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/* This path bypasses console_write() (panic/debugger output). */
+	sweet_log_append(&c, 1);
+#endif
 	_cnputc(c, true);
 }
 
