 #define SWEET_LOG_BLOCKS        (1 + SWEET_LOG_SIZE / UFS_BLOCK)
 #define SWEET_LOG_SECS          10u
 
+/*
+ * SWEETBOX mailbox (0400): a 1 MiB raw area immediately BEFORE the console
+ * log header, so the log's own layout (last 1025 blocks) is untouched and an
+ * old log reader still works. The host writes a packed, checksummed payload
+ * there from recovery with tools/sweet-box.py; sweet_box.c reads it after
+ * the root mounts. Keeping it outside the HFS image (which ends at 16 GiB in
+ * a ~107 GiB partition) means the boot path never rewrites HFS metadata.
+ */
+#define SWEET_BOX_BLOCKS        256u
+#define SWEET_BOX_BYTES         (SWEET_BOX_BLOCKS * UFS_BLOCK)
+
+/* Device LBA of mailbox block 0, or 0 when the partition is too small. */
+static uint64_t
+sweet_box_lba(void)
+{
+	if (!su.nblocks || su.nblocks < SWEET_LOG_BLOCKS + SWEET_BOX_BLOCKS + 1) {
+		return 0;
+	}
+	return su.first_block + su.nblocks - SWEET_LOG_BLOCKS - SWEET_BOX_BLOCKS;
+}
+
+/* Raw mailbox access for sweet_box.c; bounded to the reserved 1 MiB. */
+int sweet_ufs_box_read(uint32_t first, void *dst, uint32_t count);
+int sweet_ufs_box_write(uint32_t first, const void *src, uint32_t count);
+
+int
+sweet_ufs_box_read(uint32_t first, void *dst, uint32_t count)
+{
+	uint64_t base = sweet_box_lba();
+	if (!base || !count || first + count > SWEET_BOX_BLOCKS) {
+		return EINVAL;
+	}
+	int error;
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(base + first, count);
+	if (!error) {
+		memcpy(dst, (const void *)(su.dma + DMA_BOUNCE), count * UFS_BLOCK);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+int
+sweet_ufs_box_write(uint32_t first, const void *src, uint32_t count)
+{
+	uint64_t base = sweet_box_lba();
+	if (!base || !count || first + count > SWEET_BOX_BLOCKS) {
+		return EINVAL;
+	}
+	int error;
+	lck_mtx_lock(&sweet_ufs_lock);
+	memcpy((void *)(su.dma + DMA_BOUNCE), src, count * UFS_BLOCK);
+	error = ufs_write_blocks(base + first, count);
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
