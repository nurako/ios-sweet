diff --git a/bsd/sys/hakios.board.h b/bsd/sys/hakios.board.h
new file mode 100644
index 0000000..aee9b3c
--- /dev/null
+++ b/bsd/sys/hakios.board.h
@@ -0,0 +1,33 @@
+/*
+ * The board: where the blocks of the phone's SoC are (bsd/dev/hakios.board.c). The drivers of the port were
+ * brought up on one phone (the POCO X5 Pro, SM7325), and every address of a block they talk to is that
+ * phone's -- unless the kernel's command line names another: board_<block>=0x... A device profile says so
+ * (common/devices/<device>.conf, BOARD_ARGS; common/new-device.sh reads them out of the phone's own device
+ * tree), so a phone with the same blocks at other places needs no other kernel.
+ */
+#ifndef _SYS_HK_BOARD_H_
+#define _SYS_HK_BOARD_H_
+
+#include <mach/vm_types.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* the physical address of a block: board_<name>= on the command line, else `dflt` (the brought-up phone's) */
+vm_offset_t hakios_board_addr(const char *name, vm_offset_t dflt);
+/* a number of the board (counts, sizes): board_<name>=, else `dflt` */
+uint32_t hakios_board_number(const char *name, uint32_t dflt);
+/* every board_ address that was given, once, to the log (hakios.input.c, at the drivers' start) */
+void hakios_board_report(void);
+/* the loader's hakios-board names a kona phone (umi, alioth) */
+bool hakios_board_kona_name(const void *board, unsigned size);
+bool hakios_board_is_alioth(void);
+uint32_t hakios_board_panel_height(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _SYS_HK_BOARD_H_ */
diff --git a/bsd/sys/hakios.input.h b/bsd/sys/hakios.input.h
new file mode 100644
index 0000000..f54a1ca
--- /dev/null
+++ b/bsd/sys/hakios.input.h
@@ -0,0 +1,143 @@
+/*
+ * /dev/hakios-touch: touch samples on their way from whoever produces them to the
+ * program that turns them into HID events for the window server.
+ *
+ * iOS expects touches from Apple's multitouch driver through IOHIDFamily; neither exists
+ * here. Instead a producer -- a kernel driver for a real touch controller or for an emulated
+ * pointer, or a user program replaying a script -- posts samples, and code of ours running
+ * inside backboardd reads them and synthesizes the events. Both sides use the same record.
+ *
+ *   write(): one or more records (time is ignored; the kernel stamps them)
+ *   read():  blocks until there is at least one record, returns as many whole ones as fit
+ */
+#ifndef _SYS_HAKIOS_INPUT_H_
+#define _SYS_HAKIOS_INPUT_H_
+
+#include <stdint.h>
+
+#define HAKIOS_TOUCH_DEVICE    "/dev/hakios-touch"
+
+#define HAKIOS_TOUCH_DOWN      1       /* a finger has landed */
+#define HAKIOS_TOUCH_MOVE      2
+#define HAKIOS_TOUCH_UP        3       /* it has lifted (x, y: where it was last) */
+#define HAKIOS_BUTTON_DOWN     4       /* a hardware button; `finger` says which (HAKIOS_BUTTON_*), x and y are 0 */
+#define HAKIOS_BUTTON_UP       5
+
+#define HAKIOS_BUTTON_LOCK     1       /* the side button */
+#define HAKIOS_BUTTON_VOLUME_UP 2
+#define HAKIOS_BUTTON_VOLUME_DOWN 3
+#define HAKIOS_BUTTON_HOME     4
+
+struct hakios_touch {
+	uint64_t time;                  /* mach_absolute_time() when the sample was posted */
+	uint32_t type;                  /* HAKIOS_TOUCH_* or HAKIOS_BUTTON_DOWN/UP */
+	uint32_t finger;                /* which finger, from 0 (or which button) */
+	uint32_t x, y;                  /* position on the display, 0 = left/top edge, 65535 = right/bottom edge */
+};
+
+#ifdef KERNEL
+/* For drivers; not from interrupt context. */
+void hakios_touch_post(uint32_t type, uint32_t finger, uint32_t x, uint32_t y);
+void hakios_input_init(void);
+void hakios_virtio_input_init(void);   /* boot-arg virtio_input=1: QEMU's virtio pointer and keyboard */
+void hakios_goodix_init(void);         /* boot-arg touchscreen=1: the phone's Goodix or FocalTech touch screen */
+void hakios_buttons_init(void);        /* boot-arg buttons=1: the phone's power and volume keys */
+void hakios_ufs_init(void);           /* ufs=2 to xnuloader: the phone's storage, read only, through the loader (ufs_shared_pa=) */
+void hakios_ufs_report(const char *when); /* where reading the storage has spent its time so far */
+bool hakios_ufs_dev(dev_t dev);           /* one of the storage's devices */
+int hakios_ufs_read_partition(const char *name, uint64_t offset, uint8_t *dst, uint64_t len, uint64_t *bytes); /* for drivers */
+void hakios_battery_init(void);        /* boot-arg battery=1: Qualcomm UEFI charger state shared by xnuloader */
+int hakios_battery_temperature(void);  /* the battery's temperature in C, -273 while it is not known */
+/* one transfer at a time through the PMIC arbiter for this system (bsd/dev/hakios.buttons.c) */
+void hakios_spmi_lock(void);
+void hakios_spmi_unlock(void);
+/*
+ * How the battery is, as the audio DSP's battery manager says (bsd/dev/hakios.adsp.c, with adsp=1):
+ * handed to bsd/dev/hakios.battery.c, which keeps it for the sysctls kern.hakios.battery_* and
+ * passes it on to iokit/Kernel/hakios.battery.cpp, the power source that iOS reads. The structure
+ * is repeated there (this header is not seen from iokit/), and `size` tells whether the two agree.
+ */
+struct hakios_battery_state {
+	uint32_t size;                  /* sizeof(struct hakios_battery_state) */
+	int32_t percent_hundredths;     /* the charge, 0..10000 */
+	int32_t voltage_uv;
+	int32_t current_ua;             /* more than 0 while the battery takes charge */
+	int32_t temperature_hundredths; /* of a degree Celsius */
+	int32_t present;                /* 1 if there is a battery */
+	int32_t external;               /* 1 if a charger or a computer is on the USB port */
+	int32_t status;                 /* Linux's POWER_SUPPLY_STATUS_*: 1 charging, 2 discharging, 3 not charging, 4 full */
+	int32_t charge_uah, full_uah, design_uah, cycles;      /* 0 when not known (yet) */
+	int32_t usb_type;               /* Linux's POWER_SUPPLY_USB_TYPE_*: 1 a computer's port, 2 a charger, ... */
+	int32_t usb_voltage_uv, usb_current_ua;                 /* what the port gives */
+};
+void hakios_battery_report(const struct hakios_battery_state *state);
+void hakios_net_init(void);            /* en0, if there is something to carry its frames: sys/hakios.net.h */
+void hakios_usb_init(void);            /* boot-arg usb=N: the USB controller for iOS (hakios.usb.c) */
+void hakios_cpufreq_init(void);        /* boot-arg cpufreq=1: the phone's processor at full speed */
+int hakios_cpufreq_top(uint32_t domain);
+uint32_t hakios_cpufreq_khz(uint32_t domain, int row);
+void hakios_cpufreq_cap(uint32_t domain, int row);
+void hakios_screen_power(bool on);      /* the display on/off: the cores and the memory slower while it is off */
+void hakios_thermal_init(void);
+void hakios_adreno_init(void);         /* boot-arg adreno=N: the first N steps of waking the phone's GPU */
+void hakios_adreno_quiesce(void);      /* on the way back to the loader: the GPU block stopped, out of our memory */
+void hakios_adreno_stop(void);         /* before that, where the ending is no panic's: the GPU given back in order */
+void hakios_adreno_minute(void);       /* once a minute: a line about how warm the GPU is, if it is in use */
+void hakios_wifi_init(void);           /* boot-arg wifi=1: the phone's Wi-Fi; wifi_step=N: the first N steps of it */
+void hakios_slpi_init(void);           /* boot-arg slpi=1: the sensor DSP started and linked (hakios.slpi.c); slpi_step=N */
+void hakios_adsp_init(void);           /* boot-arg adsp=1: the phone's audio DSP started and linked; adsp_step=N: the first N steps */
+void hakios_mpss_init(void);           /* boot-arg modem=1: the phone's modem started and linked; modem_step=N: the first N steps */
+void hakios_wifi_stop(void);           /* where a run ends in order: the Wi-Fi DSP, if it was started, shut down */
+int hakios_wifi_say(const char *format, ...) __printflike(1, 2);      /* a line of the Wi-Fi steps' log */
+int hakios_wifi_tell(const char *format, ...) __printflike(1, 2);     /* ... one that is said even with wifi=1 */
+uint32_t hakios_wifi_option(const char *name);                         /* a boot-arg's number, or what wifi=1 stands for */
+const uint8_t *hakios_wifi_file(const char *name, uint64_t *size);     /* a file of fw/ in the small image, in place */
+bool hakios_wlfw_exchange(uint32_t step);                              /* step 15 of wifi_step=N: hakios.wlfw.c */
+bool hakios_wlfw_query(uint32_t step);                                 /* UMI: query WLFW capabilities without downloading board data */
+bool hakios_wlfw_registers(uint64_t *address, uint32_t *size, bool *mission); /* ... and what it learnt for step 16 */
+void hakios_wlfw_stop(uint32_t step);                                  /* ... and its end, before the DSP is stopped */
+void hakios_wifi_quiesce(void);        /* on the way back to the loader: the Wi-Fi DSP, if it still runs, shut down */
+/* ath11k's object and the kernel's side of it (bsd/dev/hakios.lx.c), and what that asks of the phone's radio */
+int hakios_lx_start(void);             /* the driver brought up on the radio as far as it is built: 0 or an errno */
+void hakios_lx_stop(void);             /* ... and down again, if it stayed up (a network joined) */
+int hakios_lx_prepare(void);           /* before all that: the memory the radio will be shown, taken; 0 or an errno */
+void hakios_lx_net_early(void);        /* ... and en0 made on the radio now, if the kernel was given its address */
+bool hakios_wifi_dsp_is_up(void);      /* the DSP that runs the radio's firmware has been started and has a link */
+const uint8_t *hakios_wifi_driver_file(const char *name, uint64_t *size);     /* a file by the name Linux has for it */
+bool hakios_wifi_radio_map(uint64_t physical, uint64_t size, unsigned long long *address); /* memory shown to the radio */
+bool hakios_wifi_radio_map_at(uint64_t physical, uint64_t size, unsigned long long address); /* memory shown at a stock IOVA */
+bool hakios_wifi_radio_msi(unsigned long long *address, uint32_t *data, uint32_t *first_spi); /* where the radio raises its interrupts */
+int hakios_wifi_umi_smmu_test(void); /* gated UMI diagnostic, PCIe bus mastering must remain off */
+bool umi_wifi_is_board(void);
+bool umi_wifi_normal_session(void);
+void umi_wifi_stop(void);
+void umi_wifi_quiesce(void);
+/* The gated action runs under an owned, verified context. It must hold the
+ * endpoint in reset before returning, including on error. Buffers stay wired. */
+int hakios_wifi_umi_smmu_run(int (*action)(void *), void *context);
+void hakios_wifi_umi_smmu_quiesce(void); /* panic path, only after endpoint reset */
+bool hakios_wifi_radio_address(uint8_t *address);      /* the radio's own address (boot-arg wifi_mac), if one was given */
+/* the network to join (fw/network of the small image): name and passphrase, buffer sizes in and lengths out */
+bool hakios_wifi_network(uint8_t *name, unsigned *name_length, uint8_t *passphrase, unsigned *passphrase_length);
+
+/*
+ * The GPU kept on (boot-arg adreno_keep=1), for iokit/Kernel/hakios.gpu.cpp: see "the GPU kept on"
+ * in bsd/dev/hakios.adreno.c. One caller at a time.
+ */
+bool hakios_gpu_ready(void);
+bool hakios_gpu_parameter(uint32_t which, uint64_t *value);
+uint64_t hakios_gpu_address(uint64_t size);
+void hakios_gpu_address_free(uint64_t address, uint64_t size);
+bool hakios_gpu_map(uint64_t address, uint64_t phys, bool read_only);
+void hakios_gpu_mapped(void);
+void hakios_gpu_unmap(uint64_t address, uint64_t size);
+void hakios_gpu_to_memory(void *start, uint64_t size);
+uint32_t hakios_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count);
+bool hakios_gpu_done(uint32_t fence);
+uint32_t hakios_gpu_last(void);
+void hakios_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7]);
+void hakios_gpu_report(const char *why);
+void hakios_gpu_stop(void);
+#endif
+
+#endif /* _SYS_HAKIOS_INPUT_H_ */
diff --git a/iokit/Kernel/MiniDrivers.h b/iokit/Kernel/MiniDrivers.h
new file mode 100644
index 0000000..1a35381
--- /dev/null
+++ b/iokit/Kernel/MiniDrivers.h
@@ -0,0 +1,21 @@
+/*
+ * Stand-ins for Apple's closed kernel extensions: just enough of each for the stock iOS
+ * user space to work on a machine without Apple hardware. The platform expert
+ * (GenericARMPE) starts them once the registry is up.
+ *
+ *   MiniIOSurface.cpp              IOSurface: pixel buffers shared between processes
+ *   MiniIOMobileFramebuffer.cpp    IOMobileFramebuffer: the display (the boot framebuffer)
+ *   MiniAppleKeyStore.cpp          AppleKeyStore: the keybag of a device without a passcode
+ *   MiniIONetworkStack.cpp         IONetworkStack: what configd's interface namer waits for
+ */
+#ifndef _IOKIT_MINIDRIVERS_H
+#define _IOKIT_MINIDRIVERS_H
+
+#include <IOKit/IOService.h>
+
+void MiniIOSurfaceStart(IOService * provider);
+void MiniIOMobileFramebufferStart(IOService * provider);
+void MiniAppleKeyStoreStart(void);
+void MiniIONetworkStackStart(void);
+
+#endif /* _IOKIT_MINIDRIVERS_H */
diff --git a/iokit/Kernel/MiniIOSurface.h b/iokit/Kernel/MiniIOSurface.h
new file mode 100644
index 0000000..35b00e6
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.h
@@ -0,0 +1,232 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext, enough of it for the iOS
+ * window server and its clients to share pixel buffers on a machine without Apple hardware.
+ *
+ * The protocol (user client selectors, traps and the layout of the structures the kernel
+ * hands to IOSurface.framework) was worked out from the user-space side of iOS 16.5.
+ */
+#ifndef _IOKIT_MINIIOSURFACE_H
+#define _IOKIT_MINIIOSURFACE_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#include "MiniDrivers.h"
+
+/* bsd/dev/hakios.adreno.c: a range's lines out of this processor's cache (readPixels()) */
+extern "C" void hakios_gpu_from_memory(void * start, uint64_t size);
+
+#define MINISURF_MAX_PLANES     4
+#define MINISURF_RESULT_MAX     0xa68           /* what IOSurface.framework reserves for a result */
+
+/* One plane, as IOSurface.framework reads it (0x80 bytes). */
+struct minisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* What "create" and the lookups return: this header, then the planes (at least one). */
+struct minisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct minisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct minisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+/* State that every client reads straight from memory shared with the kernel. */
+struct minisurf_shared {
+	uint64_t registryID;                    /* 0x00 */
+	uint16_t accelID;                       /* 0x08 */
+	uint16_t accelSubID;                    /* 0x0a */
+	uint32_t seed;                          /* 0x0c changes when somebody has written the pixels */
+	uint32_t reserved10;
+	uint8_t  tiled;                         /* 0x14 */
+	uint8_t  reserved15[3];
+	uint64_t useCount;                      /* 0x18 two 32-bit counters, one per category */
+	uint32_t valuesSeed;                    /* 0x20 */
+	uint32_t ycbcrMatrix;                   /* 0x24 */
+	uint32_t valuesSize;                    /* 0x28 room needed to fetch the values; 0 = none */
+	uint8_t  pixelSizeCasting;              /* 0x2c */
+	uint8_t  displayable;                   /* 0x2d */
+	uint8_t  sysMemOnly;                    /* 0x2e */
+	uint8_t  reserved2f;
+	uint8_t  attachments[0x70];             /* 0x30 the "bulk attachments" */
+};
+
+struct minisurf_aux {
+	uint64_t timestamps[4];
+	uint64_t detachModeCode;
+};
+
+#define MINISURF_AUX_OFFSET     0x400           /* of the aux structure inside the shared page */
+
+class MiniIOSurface : public OSObject
+{
+	OSDeclareDefaultStructors(MiniIOSurface);
+
+public:
+	uint32_t                        sid;
+	uint32_t                        holders;        /* clients, send rights, kernel users */
+	IOBufferMemoryDescriptor *      memory;         /* one page of shared state, then the pixels */
+	uint8_t *                       kbase;          /* the same, in the kernel */
+	/*
+	 * ... unless the surface was made around memory its maker has already (IOSurfaceAddress):
+	 * then the pixels are that memory, held in place and seen from the kernel as well, and
+	 * `memory` is the page of shared state alone.
+	 */
+	IOMemoryDescriptor *            client;
+	IOMemoryMap *                   clientMap;
+	task_t                          clientTask;     /* whose memory it is (not held: only compared, with the id) */
+	uint64_t                        clientTaskID;   /* its process's unique id: a task made later at its memory is not it */
+	mach_vm_address_t               clientAddress;  /* ... and where it is there */
+	uint8_t *                       kpixels;        /* where the pixel memory starts in the kernel, either way */
+	uint32_t                        drawn;          /* the GPU's last submission that names the pixels (0: none; HakiosGPU.cpp) */
+	bool                            gpu_written;    /* CPU cache lines may be stale after that submission */
+	/* (11-19) its maker's GPU user said only GPUs touch the pixels (the value "HakiosGPUOnly": a CAMetalLayer drawable,
+	 * libhakios.metal): hakios.gpu.cpp's cache pass need not push it on the gpu_push_ms interval (gpu_push_gpuonly=1) */
+	bool                            gpu_only;
+	/* (11-19) the seed's moves that said "HakiosGPUDrawn" (a GPU drew the pixels, no processor wrote them: eagl.c
+	 * gl_drawn_seed): hakios.gpu.cpp's cache pass takes the seed less these, so that only the other moves push it */
+	uint32_t                        drawn_moves;
+	struct minisurf_result          info;           /* addresses not filled in */
+	struct minisurf_plane           planes[MINISURF_MAX_PLANES];
+	OSDictionary *                  values;
+	uint32_t                        useCount[2];
+	uint32_t                        purgeable;
+	bool                            traced;         /* made by a program of boot-arg surftrace_of: its ports are said too */
+	uint64_t                        scanPhys;       /* the pixels' physical address if the display can scan them out (one piece below 4 GB), else 0 */
+	/*
+	 * (the K40's) A slot's pixels once more in the kernel, CACHED, for the framebuffer's reads alone (readPixels()):
+	 * the slot's own mapping is write-combined, through which the processors read uncached -- scaling a display-sized
+	 * frame out of a slot took 14 ms, out of ordinary memory 3 (touch_lat trace, 2026-11-10). Nothing writes through
+	 * it, so it never holds a dirty line, and its lines are dropped before every read.
+	 */
+	IOMemoryMap *                   readMap;
+	uint8_t *                       kreadPixels;
+	/*
+	 * (ios-sweet adapter) The SweetSurface this object was made around by
+	 * MiniIOSurfaceCopy(). NULL for a real MiniIOSurface. MiniIOSurfaceDrop()
+	 * releases it with this object.
+	 */
+	void *                          sweet_surface;
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		drawn = 0;
+		gpu_written = false;
+		gpu_only = false;
+		drawn_moves = 0;
+		scanPhys = 0;
+		readMap = NULL;
+		kreadPixels = NULL;
+		sweet_surface = NULL;
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+
+	struct minisurf_shared *
+	shared(void) const
+	{
+		return (struct minisurf_shared *) kbase;
+	}
+	struct minisurf_aux *
+	aux(void) const
+	{
+		return (struct minisurf_aux *) (kbase + MINISURF_AUX_OFFSET);
+	}
+	/* The first byte of the pixels (the "base address" clients see). */
+	uint8_t *
+	pixels(void) const
+	{
+		return kpixels + info.offset;
+	}
+	/*
+	 * (the K40's) The pixels for the processors to READ -- the framebuffer's copies of a frame: a slot's through its
+	 * cached alias, the lines of all of it dropped first (dc ivac: what the GPU or a program wrote since is what is
+	 * read); any other surface's as they are.
+	 */
+	const uint8_t *
+	readPixels(void) const
+	{
+		if (kreadPixels == NULL) {
+			return pixels();
+		}
+		hakios_gpu_from_memory(kreadPixels, info.allocSize);
+		return kreadPixels + info.offset;
+	}
+	void updateValuesState(void);
+};
+
+/*
+ * For other parts of the kernel (the framebuffer).
+ * A surface found or made here is held until MiniIOSurfaceDrop().
+ */
+MiniIOSurface * MiniIOSurfaceCopy(uint32_t sid);
+/*
+ * What making and freeing surfaces has cost since this was last asked: how many, microseconds
+ * each; how many got memory that was kept from one before.
+ */
+void            MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again);
+/* Clear the memory that is kept of surfaces that are gone, for the next ones: when the caller has a moment. */
+void            MiniIOSurfaceClearKept(void);
+/* Wait, for so many milliseconds at most, until the GPU is done with a surface's pixels (hakios.gpu.cpp). */
+bool            MiniIOSurfaceDrawn(MiniIOSurface * surface, uint64_t milliseconds);
+MiniIOSurface * MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat);
+/*
+ * Surfaces of this size with 4-byte pixels get their pixels in one of `slots` pieces of `slotBytes` from
+ * `phys` on -- memory the display's engine can scan out as it is (scanPhys) -- while one is free; the
+ * framebuffer says where (width 0: none).
+ */
+void            MiniIOSurfaceSetScanout(uint32_t width, uint32_t height, uint64_t phys, uint64_t slotBytes, unsigned slots);
+/* one slot more, of the same size, elsewhere (below 4 GB, one piece), before the first surface */
+void            MiniIOSurfaceAddScanoutSlot(uint64_t phys);
+void            MiniIOSurfaceDrop(MiniIOSurface * surface);
+/* The display's own use of a surface (+1 while it is on the panel or about to be, -1 after): what IOSurfaceIsInUse() reads. */
+void            MiniIOSurfaceUse(MiniIOSurface * surface, int delta);
+/* A Mach send right for the surface in the task (what IOSurfaceCreateMachPort gives); 0 on failure. */
+mach_port_name_t MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface);
+
+
+#endif /* _IOKIT_MINIIOSURFACE_H */
